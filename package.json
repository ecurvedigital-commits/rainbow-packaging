{
  "name": "rainbow-packaging-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run postinstall",
    "postinstall": "npm install --prefix backend && npm install --prefix frontend --include=dev && npm run build --prefix frontend && npm run db:indexes --prefix backend",
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test"
  }
}
